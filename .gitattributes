# Git Large File Storage (LFS) Configuration
# Ensures model weights are tracked separately and not stored in git history

# PyTorch model files
*.pt filter=lfs diff=lfs merge=lfs -text

# ONNX model files
*.onnx filter=lfs diff=lfs merge=lfs -text

# TensorRT engine files
*.engine filter=lfs diff=lfs merge=lfs -text
